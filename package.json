{
  "name": "squiggles",
  "version": "0.3.0",
  "description": "MCP server that lets your coding agent see the squiggles — LSP diagnostics, navigation, refactoring, and server-specific extras",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "squiggles": "dist/index.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carldaws/squiggles.git"
  },
  "keywords": [
    "mcp",
    "lsp",
    "language-server",
    "diagnostics",
    "coding-agent",
    "claude-code"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "picomatch": "^4.0.0",
    "vscode-languageserver-protocol": "^3.17.5",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
